# ─────────────────────────────────────────────────────────────────────────────
# Токены для автоматического деплоя (Render + Neon).
#
# 1. Скопируй этот файл в  deploy/.env.deploy
#       cp deploy/.env.deploy.example deploy/.env.deploy
# 2. Вставь свои токены ниже (инструкция: deploy/TOKENY.md).
# 3. Скажи ассистенту «запускай деплой» — он выполнит deploy/deploy.sh.
#
# Файл deploy/.env.deploy в .gitignore и НЕ попадёт в git. Токены не коммитятся.
# ─────────────────────────────────────────────────────────────────────────────

# Токен Neon (база PostgreSQL).  https://console.neon.tech → Account settings → API keys
NEON_API_KEY=

# Токен Render (хостинг приложения).  https://dashboard.render.com → Account Settings → API Keys
RENDER_API_KEY=

# ── Ниже трогать не нужно (значения по умолчанию). ───────────────────────────
# Заполнится автоматически после создания базы Neon (чтобы повторный запуск не плодил базы):
DATABASE_URL=

# Имена/регионы создаваемых ресурсов.
NEON_PROJECT_NAME=sumo-protokoly
NEON_REGION=aws-eu-central-1
RENDER_SERVICE_NAME=sumo-protokoly
RENDER_REGION=frankfurt
GIT_REPO=https://github.com/bliskavets/competitions_program_maker
GIT_BRANCH=main
